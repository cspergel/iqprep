{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iqprep",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist-site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "iqprep.app", "custom_domain": true },
    { "pattern": "www.iqprep.app", "custom_domain": true },
    { "pattern": "braincamp.app", "custom_domain": true },
    { "pattern": "www.braincamp.app", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
