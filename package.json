{
  "name": "brain-camp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "audit:catalog": "vite-node scripts/catalog.ts",
    "audit:cues": "vite-node scripts/cues.ts && vite-node scripts/positions.ts && vite-node scripts/vparea.ts",
    "audit:stress": "vite-node scripts/stress.ts",
    "build:site": "node scripts/build-site.mjs",
    "deploy": "npm run build:site && npx wrangler deploy",
    "deploy:iqprep": "npx wrangler deploy -c wrangler.iqprep.jsonc"
  },
  "dependencies": {
    "@fontsource/andika": "^5.3.0",
    "@fontsource/baloo-2": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
